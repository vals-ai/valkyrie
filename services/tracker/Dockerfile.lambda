FROM public.ecr.aws/lambda/python:3.12

RUN dnf install -y git \
    && dnf clean all

COPY --from=ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff /uv /uvx /bin/

WORKDIR ${LAMBDA_TASK_ROOT}

COPY services/tracker/pyproject.toml services/tracker/uv.lock ./
# uv.lock resolves ../../packages from the task root.
COPY packages/create-benchmark-service /packages/create-benchmark-service

RUN uv export --locked --no-dev --no-emit-project --no-editable --output-file requirements.txt \
    && uv pip install --system --no-config --requirements requirements.txt \
    && rm requirements.txt

COPY services/tracker/src/tracker ./tracker
COPY services/tracker/src/executor_protocol.py ./executor_protocol.py

CMD ["tracker.sandbox_cleanup.lambda_handler"]
